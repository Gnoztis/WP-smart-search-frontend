# Deny direct HTTP access to the service files of the plugin.

<FilesMatch "\.(md|txt|log|sh|bak|swp|ini|lock|dist)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Deny service directories.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.(git|idea|vscode|env) - [F,L]
</IfModule>
